{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "site-to-map site.json",
 "type": "object",
 "required": [
  "cities"
 ],
 "$defs": {
  "text": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   ]
  }
 },
 "properties": {
  "site": {
   "type": "object",
   "properties": {
    "brand": {
     "type": "string"
    },
    "domains": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "home": {
     "type": "string"
    },
    "lang": {
     "type": "string"
    },
    "storageKey": {
     "type": "string"
    },
    "copyright": {
     "type": "object",
     "properties": {
      "since": {
       "type": [
        "integer",
        "string"
       ]
      },
      "owner": {
       "type": "string"
      }
     }
    },
    "version": {
     "type": "string"
    },
    "releaseUrl": {
     "type": "string"
    },
    "description": {
     "type": "string"
    },
    "languages": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "links": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "url"
      ],
      "properties": {
       "name": {
        "$ref": "#/$defs/text"
       },
       "url": {
        "type": "string"
       },
       "icon": {
        "type": "string",
        "description": "built-in name (github, x, mail, rss, home, user, book, link), an inline <svg>, or an image URL"
       }
      }
     }
    }
   }
  },
  "text": {
   "type": "object"
  },
  "places": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "at",
     "name"
    ],
    "properties": {
     "at": {
      "enum": [
       "north",
       "riverA",
       "riverB",
       "forest",
       "fields",
       "sea",
       "bay",
       "west",
       "lake"
      ]
     },
     "name": {
      "$ref": "#/$defs/text"
     }
    }
   }
  },
  "cities": {
   "type": "array",
   "minItems": 1,
   "maxItems": 9,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "items"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "slot": {
      "enum": [
       "center",
       "coast",
       "south",
       "east",
       "highland",
       "town"
      ]
     },
     "key": {
      "type": "string",
      "pattern": "^[a-zA-Z]$"
     },
     "name": {
      "$ref": "#/$defs/text"
     },
     "role": {
      "$ref": "#/$defs/text"
     },
     "blurb": {
      "$ref": "#/$defs/text"
     },
     "style": {
      "type": "object"
     },
     "features": {
      "type": "object"
     },
     "items": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "name",
        "url"
       ],
       "properties": {
        "name": {
         "$ref": "#/$defs/text"
        },
        "url": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "desc": {
         "$ref": "#/$defs/text"
        },
        "t": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  "world": {
   "type": "object",
   "properties": {
    "layout": {
     "enum": [
      "auto",
      "classic"
     ]
    },
    "seed": {
     "type": [
      "string",
      "integer"
     ]
    },
    "type": {
     "enum": [
      "coast",
      "twoCoasts",
      "island",
      "gulf",
      "lakeland"
     ]
    },
    "townSize": {
     "enum": [
      "fixed",
      "fit"
     ]
    }
   }
  },
  "ui": {
   "type": "object",
   "properties": {
    "languageSwitch": {
     "type": "boolean"
    },
    "shortcuts": {
     "type": "boolean"
    },
    "tour": {
     "type": "boolean"
    },
    "views": {
     "type": "boolean"
    },
    "clock": {
     "type": "boolean"
    },
    "compass": {
     "type": "boolean"
    },
    "daylight": {
     "oneOf": [
      {
       "const": "auto"
      },
      {
       "type": "number",
       "minimum": 0,
       "maximum": 24
      }
     ]
    },
    "intro": {
     "type": "boolean"
    },
    "motion": {
     "type": "boolean"
    },
    "blur": {
     "type": "boolean"
    },
    "infoOpen": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  }
 }
}